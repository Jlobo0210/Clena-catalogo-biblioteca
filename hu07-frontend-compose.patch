diff --git a/frontend/Dockerfile b/frontend/Dockerfile
new file mode 100644
index 0000000..cdd4d0e
--- /dev/null
+++ b/frontend/Dockerfile
@@ -0,0 +1,21 @@
+# ---------- Etapa 1: compilar la app de React con Vite ----------
+FROM node:20-bookworm-slim AS build
+WORKDIR /app
+
+COPY package.json package-lock.json ./
+RUN npm ci
+
+COPY . .
+# Vite incrusta las variables VITE_* al compilar, por eso la URL de la API llega como argumento de build.
+ARG VITE_API_BASE_URL=http://localhost:3000/api/v1
+ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
+RUN npm run build
+
+# ---------- Etapa 2: servir los archivos estáticos con nginx ----------
+FROM nginx:1.27-alpine AS runtime
+COPY nginx.conf /etc/nginx/conf.d/default.conf
+COPY --from=build /app/dist /usr/share/nginx/html
+
+EXPOSE 80
+HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
+  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
diff --git a/frontend/nginx.conf b/frontend/nginx.conf
new file mode 100644
index 0000000..40a5691
--- /dev/null
+++ b/frontend/nginx.conf
@@ -0,0 +1,20 @@
+server {
+    listen 80;
+    server_name _;
+    root /usr/share/nginx/html;
+    index index.html;
+
+    # React Router: cualquier ruta que no sea un archivo devuelve index.html.
+    location / {
+        try_files $uri $uri/ /index.html;
+    }
+
+    # Los archivos con hash en el nombre se pueden guardar en caché mucho tiempo.
+    location /assets/ {
+        expires 1y;
+        add_header Cache-Control "public, immutable";
+    }
+
+    gzip on;
+    gzip_types text/css application/javascript application/json image/svg+xml;
+}
