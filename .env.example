# Variables de docker-compose (raíz del repo).
# Copiar a .env y completar:  cp .env.example .env
# .env NUNCA se sube al repositorio (está en .gitignore).

# --- Base de datos PostgreSQL (obligatorias) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Datos de demostración ---
# Contraseña de los usuarios de prueba (admin@, personal@ y publico@clena.example): mínimo 8 caracteres, con letras y números
SEED_PASSWORD=
# true = cargar las semillas al arrancar el backend (por defecto true)
SEED_DEMO=

# --- Puertos expuestos en tu máquina (opcionales; por defecto 5432, 3000 y 5173) ---
DB_PORT=
BACKEND_PORT=
FRONTEND_PORT=

# --- Backend (opcionales) ---
# Orígenes permitidos para el frontend, separados por coma (por defecto http://localhost:5173)
CORS_ORIGIN=
# trace | debug | info | warn | error | silent (por defecto info)
LOG_LEVEL=

# --- Frontend (opcional; por defecto http://localhost:3000/api/v1) ---
VITE_API_BASE_URL=


JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_DAYS=