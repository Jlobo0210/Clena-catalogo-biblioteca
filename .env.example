

# --- Base de datos PostgreSQL (obligatorias) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Puertos expuestos en tu máquina (opcionales; por defecto 5432, 3000 y 5173) ---
DB_PORT=
BACKEND_PORT=
FRONTEND_PORT=

# --- Backend (opcionales) ---
# Orígenes permitidos para el frontend, separados por coma (por defecto http://localhost:5173)
CORS_ORIGIN=
# trace | debug | info | warn | error | silent (por defecto info)
LOG_LEVEL=

# --- Frontend (opcional; por defecto http://localhost:3000/api/v1) ---
VITE_API_URL=
