# Copiar a .env y ajustar. Nunca subir .env al repositorio.
NODE_ENV=
PORT=
DATABASE_URL=
# Orígenes permitidos para el frontend, separados por coma (p. ej. http://localhost:5173)
CORS_ORIGIN=
# trace | debug | info | warn | error | silent (por defecto: info)
LOG_LEVEL=


JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_DAYS=
# Contraseña de los usuarios de demostración: mínimo 8 caracteres, con letras y números
SEED_PASSWORD=

# --- Préstamos (HU-26, opcionales) ---
# Plazo del préstamo en días (por defecto 15)
PRESTAMO_DIAS=
# Máximo de préstamos sin devolver por usuario (por defecto 3)
PRESTAMO_MAX_ACTIVOS=
