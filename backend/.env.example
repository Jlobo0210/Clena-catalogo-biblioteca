# Copiar a .env y ajustar. Nunca subir .env al repositorio.
NODE_ENV=
PORT=
DATABASE_URL=
# Orígenes permitidos para el frontend, separados por coma (p. ej. http://localhost:5173)
CORS_ORIGIN=
# trace | debug | info | warn | error | silent (por defecto: info)
LOG_LEVEL=


JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_DAYS=
# Contraseña de los usuarios de demostración: mínimo 8 caracteres, con letras y números
SEED_PASSWORD=

# --- Préstamos (HU-26, opcionales) ---
# Plazo del préstamo en días (por defecto 15)
PRESTAMO_DIAS=
# Máximo de préstamos sin devolver por usuario (por defecto 3)
PRESTAMO_MAX_ACTIVOS=

# --- Alertas de devolución por correo (HU-29, opcionales) ---
# Días antes de la fecha límite en que se envía el recordatorio (1 a 30, por defecto 2)
ALERTA_DIAS_ANTES=
# Horario de la tarea en formato cron, hora de Colombia (por defecto "0 8 * * *": todos los días a las 8:00)
ALERTAS_HORARIO=
# false = no programar la tarea (por defecto activa)
ALERTAS_ACTIVAS=
# Servidor SMTP. Sin SMTP_HOST los correos NO se envían: solo quedan anotados en el log.
SMTP_HOST=
# 587 (STARTTLS, por defecto) o 465 (TLS directo)
SMTP_PORT=
# true/false; por defecto true solo con el puerto 465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Obligatorio si hay SMTP_HOST, p. ej.: Biblioteca CLENA <biblioteca@ejemplo.org>
CORREO_REMITENTE=
